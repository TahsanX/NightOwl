{
  "name": "saferoute",
  "version": "0.1.0",
  "private": true,
  "description": "Safety-first navigation that scores routes by nearby open activity and assistance points.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @saferoute/backend",
    "dev:mobile": "npm run start --workspace @saferoute/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
