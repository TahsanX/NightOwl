# Copy to .env and fill in. Nothing in src/ may hardcode these values.
PORT=4000
NODE_ENV=development

# Routing provider: osrm | graphhopper
ROUTING_PROVIDER=osrm
# Public demo server — rate limited, do not use in production.
OSRM_BASE_URL=https://router.project-osrm.org
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
GRAPHHOPPER_API_KEY=

# Places provider: geoapify | overpass
PLACES_PROVIDER=geoapify
GEOAPIFY_BASE_URL=https://api.geoapify.com/v2
GEOAPIFY_API_KEY=

# Surveillance cameras come from OSM tags via Overpass.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Community reports store: memory | postgis
REPORT_STORE=memory
DATABASE_URL=postgres://saferoute:saferoute@localhost:5432/saferoute

# Seconds. Upstream geodata changes slowly; caching keeps us inside rate limits.
PLACES_CACHE_TTL_S=900
CAMERAS_CACHE_TTL_S=86400
# Generous because the public Overpass instance regularly takes 30-60s for a
# city-sized query. With a Geoapify key, or a self-hosted Overpass, lower it.
UPSTREAM_TIMEOUT_MS=120000
# How long a route plan waits for optional layers (cameras, community reports)
# before scoring without them. A late result still lands in the cache.
OPTIONAL_LAYER_BUDGET_MS=5000
