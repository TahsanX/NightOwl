{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "API_BASE_URL": "https://nightowl-api.onrender.com/api/v1"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "API_BASE_URL": "https://nightowl-api.onrender.com/api/v1"
      }
    }
  }
}
