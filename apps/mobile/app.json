{
  "expo": {
    "name": "SafeRoute",
    "slug": "saferoute",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "saferoute",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SafeRoute uses your location to plan routes and show nearby help points."
      }
    },
    "android": {
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafeRoute uses your location to plan routes and show nearby help points."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1",
      "mapStyleUrl": "https://demotiles.maplibre.org/style.json"
    }
  }
}
